{
  "Puerto": 8000,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "YoPago": "Host=localhost;Port=5432;Database=yopago;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Emisor": "yopago-api",
    "Audiencia": "yopago-web",
    "Clave": "",
    "MinutosVigencia": 20
  },
  "App": {
    "UrlFront": "http://localhost:4200",
    "DiasPorVencer": 3,
    "MinutosIntentoPago": 10
  },
  "Seguridad": {
    "MaxIntentosFallidos": 3,
    "MinutosBloqueo": 15,
    "MinutosTokenRecuperacion": 30
  },
  "Cors": {
    "Origenes": [
      "http://localhost:4200"
    ]
  },
  "Swagger": {
    "Habilitado": true
  },
  "BaseDatos": {
    "CrearAlIniciar": true,
    "CargarDatosPrueba": false
  },
  "DatosDesarrollo": {
    "Habilitado": false
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Puerto": 587,
    "Remitente": "",
    "Usuario": "",
    "Clave": "",
    "UsarSsl": true
  },
  "Directorio": {
    "Modo": "Local"
  },
  "Ldap": {
    "Host": "localhost",
    "Puerto": 389,
    "UsarSsl": false,
    "UsarStartTls": false,
    "PlantillaUsuario": "uid={cedula},ou=clientes,dc=yopago,dc=local",
    "BaseUsuarios": "ou=clientes,dc=yopago,dc=local",
    "AtributoLogin": "uid",
    "AtributoClave": "userPassword",
    "UsuarioAdmin": "",
    "ClaveAdmin": "",
    "TimeoutSegundos": 10
  },
  "Pasarela": {
    "LatenciaMs": 600,
    "CedulasRechazadas": []
  },
  "Sso": {
    "ApiKeyEntrante": "",
    "ApiKeySaliente": "",
